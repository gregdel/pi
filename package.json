{
  "name": "pi-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Pi extensions and reusable prompts",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 extensions tests eslint.config.mjs"
  },
  "pi": {
    "extensions": ["./extensions/*.ts"],
    "prompts": ["./prompts/*.md"]
  },
  "dependencies": {
    "diff": "8.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
